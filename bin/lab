#!/usr/bin/env bash
#== usage ==
# Control the serving plane. The same script runs on both nodes and does the
# right thing for whichever one it is on.
#
#   lab up      [--warm]     start everything (optionally preload this node's model)
#   lab down    [--boot-off] stop everything (optionally also disable autostart)
#               [--gpu-only] stop only what holds the GPU; leave the front door up
#   lab pool    up|down      one model across BOTH cards (run it from the laptop)
#   lab status               what is running, and is the GPU actually free
#   lab reload  [svc]        apply edited config files (they are read-only mounts)
#   lab check                validate configs before a push deploys them
#   lab install              (re)write this node's systemd unit from the repo
#   lab logs    <svc>        follow logs (llama-swap|litellm|prometheus|grafana|model|pool)
#== end usage ==
#
# Node roles differ, so the script's work differs:
#
#   desktop (sm_86)  always-on server. llama-swap + LiteLLM + Prometheus + Grafana.
#   laptop  (sm_120) not always-on. llama-swap only -- the desktop's LiteLLM routes
#                    to it over the direct link, so it serves without a front door
#                    of its own and has no monitoring stack to start.
#
# The two nodes stay independently controllable on purpose: Phase 2b trains on the
# desktop while the laptop keeps answering on the same base URL.
#
# "lab pool" is the one exception, and the only command here that touches both
# nodes at once: vLLM pipeline parallelism splitting a single model across both
# cards, for models that fit on neither. It is mutually exclusive with
# llama-swap -- ~40 GiB of weights leaves neither card room for a second model
# -- so "lab pool up" stops llama-swap on both ends first and "lab up" refuses
# while the pool holds the card.
#
# It runs from the laptop only. That is a fact about the machines, not a
# preference: the laptop runs no sshd, so ssh to it from the desktop is refused,
# and driving both ends requires reaching the other one.
#
# Order matters. Coming up: llama-swap before LiteLLM, so the front door never
# advertises an upstream that cannot answer. Going down: LiteLLM first, so nothing
# new arrives while models are being evicted.
set -euo pipefail

REPO=/home/david/gpu-lab

# ---- the pool (see the note above) ----
# Hardcoded names and addresses rather than discovery. Two containers on two
# known hosts is not a fleet, and a fixed name is what lets "lab down" and
# "lab status" recognise the pool on the node that is not driving it.
POOL_IMAGE=gpu-lab:vllm-ray
POOL_MODEL=Qwen/Qwen3-14B
POOL_PORT=8200
POOL_MAXLEN=8192
DESKTOP_ADDR=10.10.0.1; DESKTOP_NIC=enp5s0
LAPTOP_ADDR=10.10.0.2;  LAPTOP_NIC=enp129s0
# The per-node blocks below set an idle floor for whichever node is running this
# script, but the pool has to judge both cards at once and it always runs from
# the laptop -- so the desktop's floor has to be named here as well.
DESKTOP_IDLE_MIB=1000

# ---- which node is this? ----
# Compute capability is the primary signal, not hostname: it is the axis the whole
# lab is built on, it cannot drift, and it still answers when the direct link is
# down (which on the laptop is a routine post-suspend state, not an anomaly).
detect_node() {
    [ -n "${GPU_LAB_NODE:-}" ] && { echo "$GPU_LAB_NODE"; return; }
    case "$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ')" in
        8.6)  echo desktop ;;
        12.0) echo laptop  ;;
        *) case "$(hostname)" in
               davids-llm-server)           echo desktop ;;
               david-Legion-Pro-7-16IAX10H) echo laptop  ;;
               *) echo unknown ;;
           esac ;;
    esac
}
# Usage is answered before the node gate: on a third machine "lab" used to print
# its own help, and a node-detection failure should not take that away.
case "${1:-}" in
    up|down|pool|status|reload|logs|check|install) ;;
    *) awk '/^#== usage ==/{f=1;next} /^#== end usage ==/{f=0} f' "$0" | sed 's/^# \?//'; exit 1 ;;
esac

NODE=$(detect_node)

case "$NODE" in
    desktop)
        SWAP_CONFIG=$REPO/nodes/desktop/llama-swap.yaml
        SWAP_UNIT=$REPO/nodes/desktop/llama-swap.service
        COMPOSE_DIR=$REPO/monitoring # LiteLLM + Prometheus + Grafana live here only
        HAS_COMPOSE=1
        WARM_MODEL=qwen3-coder
        WARM_KIND=chat
        # Headless: anything above a trickle means something is still attached.
        GPU_IDLE_MIB=1000
        FRONT_DOOR="http://10.10.0.1:4000/v1"
        ;;
    laptop)
        SWAP_CONFIG=$REPO/nodes/laptop/llama-swap.yaml
        SWAP_UNIT=$REPO/nodes/laptop/llama-swap.service
        COMPOSE_DIR=
        HAS_COMPOSE=0
        WARM_MODEL=qwen3-embed
        # A pooling model does not serve /v1/chat/completions -- warming it through
        # the chat route would 400 and look like a dead endpoint.
        WARM_KIND=embed
        # The laptop drives a display: the desktop session alone holds ~1.3 GiB at
        # idle, so the desktop's 1000 MiB floor would never be reached here and
        # "lab down" would report a permanent false failure.
        # Blind spot: this floor cannot see a process holding less than
        # ~1.7 GiB above the display. Fine for a model (8.4 GiB), not a
        # guarantee that a small training job has exited.
        GPU_IDLE_MIB=3000
        FRONT_DOOR="http://10.10.0.2:8080/v1  (via the desktop's LiteLLM at http://10.10.0.1:4000/v1)"
        ;;
    *)
        echo "cannot identify this node (no sm_86/sm_120 GPU, unrecognised hostname)." >&2
        echo "set GPU_LAB_NODE=desktop|laptop to override." >&2
        exit 1
        ;;
esac

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()  { printf '  %s\n' "$*"; }

gpu_used_mib() { nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1; }

wait_gpu_clear() {
    for _ in $(seq 1 30); do
        [ "$(gpu_used_mib)" -lt "$GPU_IDLE_MIB" ] && return 0
        sleep 2
    done
    return 1
}

peer_addr() { case "$NODE" in desktop) echo 10.10.0.2 ;; laptop) echo 10.10.0.1 ;; esac; }

# The "llm" alias resolves to 10.10.0.1 over the direct link (see ~/.ssh/config),
# so it stops working when that link does. That is the honest dependency rather
# than a limitation: the pool runs NCCL over the same cable, so an ssh route that
# survived the link going down would only let it fail later and less clearly.
on_desktop() { ssh -o ConnectTimeout=5 llm "$@"; }
desktop_gpu_used_mib() { on_desktop 'nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits' 2>/dev/null | head -1; }

cmd_up() {
    local n=1 total=$(( HAS_COMPOSE ? 4 : 3 ))

    # Preflight, and it must come first. This node's weights arrive over the
    # direct link (/srv/model-cache is NFS from the desktop) and the unit carries
    # RequiresMountsFor, so a wedged I226 makes "systemctl start" fail with an
    # opaque mount error -- and set -e would kill this script before reaching the
    # repair hint written for exactly this case.
    if [ "$HAS_COMPOSE" = 0 ] && ! ping -c1 -W2 "$(peer_addr)" >/dev/null 2>&1; then
        echo "  direct link to $(peer_addr) is DOWN." >&2
        echo "  /srv/model-cache is NFS over that link and the unit requires it," >&2
        echo "  so llama-swap cannot start. Repair, then retry:" >&2
        echo "    sudo /usr/local/sbin/gpu-lab-igc-resume-repair" >&2
        exit 1
    fi

    # Starting the serving plane during a kernel differential ruins the run: the
    # first request loads a model into the card the suite is measuring, and the
    # resulting allocation failures read as architecture findings rather than as
    # a scheduling mistake. Warn loudly; do not block, because the operator may
    # genuinely want serving back more than they want the run.
    if sudo docker ps --format '{{.Names}}' | grep -q '^gpu-lab-kernels$'; then
        echo "  WARNING: a kernel differential is running (kernels/run.sh)." >&2
        echo "           Loading a model now will corrupt its results." >&2
    fi
    # Same hazard, different job: a QLoRA run holds most of the card, and a model
    # load now would either OOM the trainer or be OOM'd by it. Hours of training
    # are worth more than a warm model, so this one is worth reading twice.
    if sudo docker ps --format '{{.Names}}' | grep -q '^gpu-lab-training$'; then
        echo "  WARNING: a QLoRA run is in progress (training/run.sh)." >&2
        echo "           Loading a model now may OOM it, losing the whole run." >&2
    fi

    # Unlike the two warnings above, this one stops. A kernel run or a QLoRA job
    # leaves enough of the card that loading a model is merely a bad idea; the
    # pool holds ~20 GiB on each node, so llama-swap would not be making a
    # mistake so much as attempting the impossible. Refusing here is also what
    # keeps the front door honest -- LiteLLM cannot advertise qwen3-coder as
    # reachable if llama-swap never starts to serve it.
    if sudo docker ps --format '{{.Names}}' | grep -qE '^ray-(head|worker)$'; then
        echo "  the pool is holding this card ($(gpu_used_mib) MiB in use)." >&2
        echo "  it and llama-swap cannot be co-resident. stop it first, from the laptop:" >&2
        echo "    $REPO/bin/lab pool down" >&2
        exit 1
    fi

    # Before llama-swap, and deliberately not stopped by "down --gpu-only": the
    # window this exporter exists for is the one where the serving plane is down
    # and a training run has the card to itself.
    say "$((n++))/$total  gpu exporter (thermals, power, throttle)"
    sudo systemctl start gpu-exporter 2>/dev/null \
        && ok "$(sudo systemctl is-active gpu-exporter)" \
        || ok "not installed -- run: lab install"

    say "$((n++))/$total  llama-swap (model router)"
    if [ ! -f "$SWAP_CONFIG" ]; then
        echo "  missing model config: $SWAP_CONFIG" >&2
        echo "  llama-swap cannot start without it." >&2
        exit 1
    fi
    sudo systemctl start llama-swap
    for _ in $(seq 1 30); do
        curl -sf localhost:8080/v1/models >/dev/null 2>&1 && break; sleep 1
    done
    ok "$(sudo systemctl is-active llama-swap)"

    if [ "$HAS_COMPOSE" = 1 ]; then
        say "$((n++))/$total  monitoring + front door"
        ( cd "$COMPOSE_DIR" && sudo docker compose up -d )
        for _ in $(seq 1 40); do
            curl -sf localhost:4000/health/liveliness >/dev/null 2>&1 && break; sleep 2
        done
    fi

    say "$((n++))/$total  checks"
    ok "llama-swap models : $(curl -s localhost:8080/v1/models | python3 -c 'import json,sys;print(*[m["id"] for m in json.load(sys.stdin)["data"]])' 2>/dev/null || echo '(not ready)')"
    if [ "$HAS_COMPOSE" = 1 ]; then
        ok "prometheus up     : $(curl -s 'localhost:9090/api/v1/query?query=up' >/dev/null 2>&1 && echo yes || echo no)"
        ok "grafana           : $(curl -s localhost:3000/api/health 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin)["database"])' 2>/dev/null || echo '(not ready)')"
        ok "litellm           : $(curl -s localhost:4000/health/liveliness >/dev/null 2>&1 && echo alive || echo '(not ready)')"
    fi

    # Both nodes. The desktop especially: LiteLLM publishes qwen3-embed with an
    # api_base of 10.10.0.2, so an all-green front door here can still be
    # advertising an upstream that nothing can reach.
    if ping -c1 -W2 "$(peer_addr)" >/dev/null 2>&1; then
        ok "peer $(peer_addr)     : OK"
    elif [ "$HAS_COMPOSE" = 1 ]; then
        ok "peer $(peer_addr)     : UNREACHABLE -- qwen3-embed falls back to this node (~90 s load)"
    else
        ok "peer $(peer_addr)     : UNREACHABLE -- this node is serving to nobody."
        ok "                      sudo /usr/local/sbin/gpu-lab-igc-resume-repair"
    fi

    if [ "${1:-}" = "--warm" ]; then
        say "warming $WARM_MODEL (cold load)"
        case "$WARM_KIND" in
            chat)  route=/v1/chat/completions
                   body="{\"model\":\"$WARM_MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}" ;;
            embed) route=/v1/embeddings
                   body="{\"model\":\"$WARM_MODEL\",\"input\":\"warm\"}" ;;
            *)     route=""; body="" ;;
        esac
        if [ -z "$route" ]; then
            ok "WARNING: no warm route defined for kind '$WARM_KIND' -- skipped"
        elif curl -sf "localhost:8080$route" -H 'Content-Type: application/json' -d "$body" >/dev/null; then
            ok "loaded, $(gpu_used_mib) MiB in use"
        else
            ok "WARNING: warm request to $route failed -- model did not load"
        fi
    fi
    say "up ($NODE). front door: $FRONT_DOOR"
}

cmd_down() {
    # --gpu-only exists because LiteLLM, Prometheus and Grafana are CPU
    # containers: none of them requests a GPU, so nothing about freeing the card
    # requires stopping them. Phase 2b is where that matters. The runbook
    # promises "the desktop trains, the laptop serves, and your tools never
    # notice" -- and a full "lab down" makes that impossible, because the front
    # door LiteLLM provides is itself on the training node. Stopping it means no
    # laptop-side failover can work, whatever the config says.
    #
    # So: --gpu-only stops llama-swap and anything holding the card, and leaves
    # the routing and monitoring layers running. qwen3-embed keeps answering
    # from the laptop through the same base URL with no config change, and
    # Prometheus keeps scraping it, so the run is observable while it happens.
    local gpu_only=0 boot_off=0
    for arg in "$@"; do
        case "$arg" in
            --gpu-only) gpu_only=1 ;;
            --boot-off) boot_off=1 ;;
            "")         ;;
            *)          echo "  unknown flag for 'lab down': $arg" >&2; exit 1 ;;
        esac
    done

    # Not the same arithmetic as cmd_up: here the compose guard wraps two numbered
    # steps (LiteLLM first, monitoring last), so without compose there is exactly one.
    local n=1 total=1
    [ "$HAS_COMPOSE" = 1 ] && [ "$gpu_only" = 0 ] && total=3

    if [ "$HAS_COMPOSE" = 1 ] && [ "$gpu_only" = 0 ]; then
        say "$((n++))/$total  LiteLLM (stop accepting new work first)"
        ( cd "$COMPOSE_DIR" && sudo docker compose stop litellm ) 2>&1 | tail -1
    fi

    say "$((n++))/$total  llama-swap + any loaded model"
    # llama-swap runs each model's cmdStop on shutdown; give it room to finish.
    sudo systemctl stop llama-swap || true
    ok "llama-swap: $(sudo systemctl is-active llama-swap || true)"
    # Safety net: if llama-swap died uncleanly its upstream can outlive it and keep
    # the GPU pinned, which silently blocks the next start.
    # Also sweeps a kernel differential run (kernels/run.sh). That is not part of
    # the serving plane, but it holds the entire card for as long as it lasts, and
    # an interrupted run leaves its container behind to block the next model load.
    # ray-head/ray-worker are in this list because without them the sweep was a
    # lie: a pooled run holds ~20 GiB, matched none of the patterns, and the only
    # symptom was the unexplained "GPU still holds N MiB" warning below.
    for c in $(sudo docker ps --format '{{.Names}}' | grep -E '^(qwen3-|gpu-lab-kernels$|gpu-lab-training$|ray-head$|ray-worker$)' || true); do
        case "$c" in
            ray-head|ray-worker)
                # Removed rather than stopped: these are named singletons, and a
                # merely-stopped ray-head fails the next "lab pool up" on "name
                # already in use" -- which reads as a pool bug, not as debris.
                ok "force-removing this node's half of the pool: $c"
                sudo docker rm -f "$c" >/dev/null || true
                # Stopping one end from one node is as far as a node-local
                # command can go. Say so, rather than report a clean stop while
                # the peer still holds its own card.
                ok "  the peer still holds its half -- 'lab pool down' on the laptop stops both"
                ;;
            *)
                ok "force-stopping orphaned container: $c"
                sudo docker stop "$c" >/dev/null || true
                ;;
        esac
    done

    if [ "$HAS_COMPOSE" = 1 ] && [ "$gpu_only" = 0 ]; then
        say "$((n++))/$total  monitoring"
        ( cd "$COMPOSE_DIR" && sudo docker compose stop prometheus grafana ) 2>&1 | tail -1
    fi

    if wait_gpu_clear; then
        ok "GPU released ($(gpu_used_mib) MiB in use, idle floor $GPU_IDLE_MIB)"
    else
        printf '  WARNING: GPU still holds %s MiB -- something is still attached\n' "$(gpu_used_mib)"
        sudo docker ps --format '    still running: {{.Names}}' || true
    fi

    if [ "$boot_off" = 1 ]; then
        sudo systemctl disable llama-swap >/dev/null 2>&1 || true
        if [ "$HAS_COMPOSE" = 1 ]; then
            ok "autostart disabled (compose services already respect a manual stop)"
        else
            ok "autostart disabled"
        fi
    else
        ok "note: everything returns on reboot. use --boot-off to prevent that."
    fi

    if [ "$gpu_only" = 1 ]; then
        if [ "$HAS_COMPOSE" = 1 ]; then
            ok "front door still UP -- models on this node are gone, but LiteLLM"
            ok "still routes, so anything served by the peer keeps answering."
            # Say plainly which models just stopped being reachable, rather than
            # leaving "the front door is up" to imply everything still works.
            ok "unreachable until 'lab up': $(python3 -c "
import sys,yaml
try:
    cfg=yaml.safe_load(open('$REPO/serving/litellm-config.yaml'))
    here=[m['model_name'] for m in cfg.get('model_list',[])
          if '127.0.0.1' in str(m.get('litellm_params',{}).get('api_base','')) 
          or '10.10.0.1' in str(m.get('litellm_params',{}).get('api_base',''))]
    print(', '.join(here) or '(none)')
except Exception: print('(could not read litellm config)')
" 2>/dev/null)"
        else
            ok "this node's models are stopped; it has no front door of its own."
        fi
        say "down --gpu-only ($NODE). the card is free; routing is untouched."
    else
        say "down ($NODE)."
    fi
}

# Laptop-only, and the check says why rather than just refusing: a node that
# cannot ssh to its peer cannot drive a two-node command, and that is the whole
# explanation.
pool_require_driver() {
    if [ "$NODE" != laptop ]; then
        echo "  'lab pool' runs from the laptop, not the $NODE." >&2
        echo "  the laptop has no sshd, so this node cannot reach it to drive the other end." >&2
        echo "  run it there:  $REPO/bin/lab pool $1" >&2
        exit 1
    fi
    if ! ping -c1 -W2 "$DESKTOP_ADDR" >/dev/null 2>&1; then
        echo "  direct link to $DESKTOP_ADDR is DOWN, and the pool runs NCCL over it." >&2
        echo "    sudo /usr/local/sbin/gpu-lab-igc-resume-repair" >&2
        exit 1
    fi
    if ! on_desktop true >/dev/null 2>&1; then
        echo "  cannot ssh to the desktop (alias 'llm'). the link answers ping, so" >&2
        echo "  this is the agent or the key -- see the dual-boot note in the runbook." >&2
        exit 1
    fi
}

# Both cards, not just this one. The desktop's floor differs from the laptop's
# because the laptop drives a display; see the per-node blocks above.
pool_wait_cards() {
    for _ in $(seq 1 30); do
        if [ "$(gpu_used_mib)" -lt "$GPU_IDLE_MIB" ] \
        && [ "$(desktop_gpu_used_mib)" -lt "$DESKTOP_IDLE_MIB" ]; then
            return 0
        fi
        sleep 2
    done
    return 1
}

pool_up() {
    pool_require_driver up
    local n=1 total=5

    say "$((n++))/$total  preflight"
    if ! sudo docker images --format '{{.Repository}}:{{.Tag}}' | grep -qx "$POOL_IMAGE"; then
        echo "  $POOL_IMAGE is not built on the laptop -- see serving/Dockerfile.vllm-ray" >&2
        exit 1
    fi
    if ! on_desktop 'sudo docker images --format "{{.Repository}}:{{.Tag}}"' | grep -qx "$POOL_IMAGE"; then
        echo "  $POOL_IMAGE is not built on the desktop -- see serving/Dockerfile.vllm-ray" >&2
        exit 1
    fi
    ok "$POOL_IMAGE present on both nodes"
    if sudo docker ps --format '{{.Names}}' | grep -qE '^gpu-lab-(kernels|training)$'; then
        echo "  a kernel or training run holds this card, and the pool needs all of it." >&2
        exit 1
    fi
    ok "no kernel or training run in the way"

    # On both nodes, and the desktop is the one that matters. Driven by hand this
    # step was missed every time: the desktop's llama-swap stays active while the
    # pool takes its VRAM, LiteLLM keeps advertising qwen3-coder as reachable,
    # and the next request tries a cold load into the few GiB the pool left.
    say "$((n++))/$total  stopping llama-swap on both nodes"
    sudo systemctl stop llama-swap || true
    ok "laptop  : $(sudo systemctl is-active llama-swap || true)"
    on_desktop 'sudo systemctl stop llama-swap' || true
    ok "desktop : $(on_desktop 'sudo systemctl is-active llama-swap' || true)"
    for c in $(sudo docker ps --format '{{.Names}}' | grep '^qwen3-' || true); do
        ok "stopping loaded model: $c"
        sudo docker stop "$c" >/dev/null || true
    done
    on_desktop 'for c in $(sudo docker ps --format "{{.Names}}" | grep "^qwen3-" || true); do sudo docker stop "$c" >/dev/null || true; done' || true
    if pool_wait_cards; then
        ok "both cards free (desktop $(desktop_gpu_used_mib) MiB, laptop $(gpu_used_mib) MiB)"
    else
        echo "  WARNING: desktop $(desktop_gpu_used_mib) MiB, laptop $(gpu_used_mib) MiB still in use;" >&2
        echo "           the pool needs ~20 GiB per card and may fail to allocate." >&2
    fi

    say "$((n++))/$total  ray cluster"
    on_desktop "sudo docker rm -f ray-head >/dev/null 2>&1 || true"
    on_desktop "sudo docker run -d --name ray-head --network host --ipc=host --gpus all \
        -v /srv/model-cache:/hf -e HF_HOME=/hf -e HF_HUB_OFFLINE=1 \
        -e NCCL_SOCKET_IFNAME=$DESKTOP_NIC -e GLOO_SOCKET_IFNAME=$DESKTOP_NIC -e NCCL_IB_DISABLE=1 \
        -e VLLM_HOST_IP=$DESKTOP_ADDR \
        $POOL_IMAGE bash -c 'ray start --head --node-ip-address=$DESKTOP_ADDR --port=6379 --num-gpus=1 --block'" >/dev/null
    for _ in $(seq 1 20); do
        on_desktop 'sudo docker exec ray-head ray status' >/dev/null 2>&1 && break
        sleep 2
    done
    ok "head   : ray-head on $DESKTOP_ADDR:6379"

    sudo docker rm -f ray-worker >/dev/null 2>&1 || true
    sudo docker run -d --name ray-worker --network host --ipc=host --gpus all \
        -v /srv/model-cache:/hf -e HF_HOME=/hf -e HF_HUB_OFFLINE=1 \
        -e NCCL_SOCKET_IFNAME=$LAPTOP_NIC -e GLOO_SOCKET_IFNAME=$LAPTOP_NIC -e NCCL_IB_DISABLE=1 \
        -e VLLM_HOST_IP=$LAPTOP_ADDR \
        $POOL_IMAGE bash -c "ray start --address=$DESKTOP_ADDR:6379 --node-ip-address=$LAPTOP_ADDR --num-gpus=1 --block" >/dev/null

    # Registration, not liveness. A worker that started and failed to join looks
    # identical from "docker ps", and vLLM would then place the whole model on
    # one card, OOM, and blame the model rather than the cluster.
    local registered=0
    for _ in $(seq 1 30); do
        if on_desktop 'sudo docker exec ray-head ray status' 2>/dev/null | grep -qE '/2\.0 GPU'; then
            registered=1; break
        fi
        sleep 2
    done
    if [ "$registered" = 0 ]; then
        echo "  the worker never registered -- 'ray status' did not reach 2 GPUs." >&2
        echo "    sudo docker logs ray-worker" >&2
        exit 1
    fi
    ok "worker : registered; head sees 2 GPUs"

    say "$((n++))/$total  vllm serve $POOL_MODEL across both cards"
    # --no-enable-flashinfer-autotune is the whole reason this works, and it must
    # not be dropped as noise. The autotune hook is gated PER DEVICE on compute
    # capability >= 9.0 but contains a WORLD-level broadcast: the sm_120 laptop
    # passes the gate and enters it, the sm_86 desktop never calls it, and
    # startup deadlocks until a 30-minute Gloo timeout. The only visible symptom
    # is EngineCore logging "No available shared memory broadcast block found in
    # 60 seconds" once a minute forever -- which points at shared memory and at
    # cross-host transport, both of which are fine. Any mixed-capability pair
    # straddling sm_90 hits this class of bug.
    on_desktop "sudo docker exec -d ray-head bash -c '
        vllm serve $POOL_MODEL \
          --pipeline-parallel-size 2 --distributed-executor-backend ray \
          --no-enable-flashinfer-autotune \
          --host 0.0.0.0 --port $POOL_PORT --max-model-len $POOL_MAXLEN \
          --gpu-memory-utilization 0.85 \
          > /tmp/vllm-pool.log 2>&1'"
    ok "launched; log: ssh llm \"sudo docker exec ray-head tail -f /tmp/vllm-pool.log\""

    say "$((n++))/$total  waiting for the endpoint"
    local url="http://$DESKTOP_ADDR:$POOL_PORT/v1/models" served=0
    # ~230 s is normal: weights load from the NFS cache over the direct link and
    # the engine compiles on first start. The budget is deliberately well past it.
    for _ in $(seq 1 150); do
        curl -sf -m3 "$url" >/dev/null 2>&1 && { served=1; break; }
        sleep 2
    done
    if [ "$served" = 0 ]; then
        echo "  $url did not answer within 5 minutes." >&2
        echo "    ssh llm \"sudo docker exec ray-head tail -40 /tmp/vllm-pool.log\"" >&2
        exit 1
    fi
    ok "models : $(curl -s "$url" | python3 -c 'import json,sys;print(*[m["id"] for m in json.load(sys.stdin)["data"]])' 2>/dev/null || echo '(unparseable)')"
    ok "split  : desktop $(desktop_gpu_used_mib) MiB + laptop $(gpu_used_mib) MiB"
    say "pool up. endpoint: http://$DESKTOP_ADDR:$POOL_PORT/v1"
    ok "not on the LiteLLM front door -- this endpoint is direct."
    ok "llama-swap is stopped on both nodes; 'lab pool down' then 'lab up' restores it."
}

pool_down() {
    pool_require_driver down
    local n=1 total=2

    say "$((n++))/$total  removing the ray containers"
    if sudo docker rm -f ray-worker >/dev/null 2>&1; then
        ok "laptop  : ray-worker removed"
    else
        ok "laptop  : ray-worker was not there"
    fi
    if on_desktop 'sudo docker rm -f ray-head' >/dev/null 2>&1; then
        ok "desktop : ray-head removed"
    else
        ok "desktop : ray-head was not there"
    fi

    say "$((n++))/$total  cards"
    if pool_wait_cards; then
        ok "both released (desktop $(desktop_gpu_used_mib) MiB, laptop $(gpu_used_mib) MiB)"
    else
        printf '  WARNING: desktop %s MiB, laptop %s MiB still in use\n' \
            "$(desktop_gpu_used_mib)" "$(gpu_used_mib)"
    fi

    say "pool down."
    # Read both, do not assert. Tearing down a pool that was started by hand
    # leaves whatever llama-swap was already running still running, and the
    # first draft of this said "serving is still stopped" while the desktop's
    # was active -- the same assert-instead-of-observe mistake that made
    # "lab down" report an unexplained GPU figure.
    local l d
    l=$(sudo systemctl is-active llama-swap 2>/dev/null || true)
    d=$(on_desktop 'sudo systemctl is-active llama-swap' 2>/dev/null || true)
    ok "llama-swap  laptop: ${l:-unknown}   desktop: ${d:-unknown}"
    # "lab up" is per-node by design, so it takes one command on each node that
    # is not already serving; silence here would leave the lab looking broken.
    [ "$d" = active ] || ok "  ssh llm '$REPO/bin/lab up'"
    [ "$l" = active ] || ok "  $REPO/bin/lab up"
}

cmd_pool() {
    case "${1:-}" in
        up)   pool_up ;;
        down) pool_down ;;
        *)    echo "usage: lab pool <up|down>" >&2; exit 1 ;;
    esac
}

cmd_status() {
    say "node"
    ok "$NODE  ($(hostname), $(nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader 2>/dev/null || echo 'no GPU'))"

    # Read once, used three times below. A pooled card explains a stopped
    # llama-swap, an otherwise anomalous GPU figure, and a DOWN endpoint -- and
    # without it all three read as faults.
    local pooled
    pooled=$(sudo docker ps --format '{{.Names}}' | grep -E '^ray-(head|worker)$' || true)

    say "services"
    if sudo systemctl cat llama-swap >/dev/null 2>&1; then
        sv=$(sudo systemctl is-active llama-swap 2>/dev/null || true)
    else
        # is-active alone cannot tell these apart: it prints "inactive" and exits 3
        # for a unit that was never installed.
        sv="not installed"
    fi
    ok "llama-swap : ${sv:-unknown}"
    if [ -n "$pooled" ] && [ "$sv" != active ]; then
        ok "             not a fault -- the pool ($pooled) holds this card"
    fi
    if sudo systemctl cat gpu-exporter >/dev/null 2>&1; then
        gx=$(sudo systemctl is-active gpu-exporter 2>/dev/null || true)
        curl -sf localhost:9835/metrics >/dev/null 2>&1 || gx="${gx:-unknown} (not scrapable)"
    else
        gx="not installed"
    fi
    ok "gpu-exporter : ${gx:-unknown}"
    if [ "$HAS_COMPOSE" = 1 ]; then
        ( cd "$COMPOSE_DIR" && sudo docker compose ps --format '  {{.Name}}: {{.State}}' ) 2>/dev/null || true
    else
        ok "(no compose stack on this node -- LiteLLM/Prometheus/Grafana run on the desktop)"
    fi

    say "models"
    # The indent comes from sed, not the template: docker strips leading
    # whitespace out of --format, so these lines printed flush-left next to
    # everything ok() emits.
    sudo docker ps --format 'loaded:     {{.Names}} ({{.Status}})' | grep qwen3 | sed 's/^/  /' || ok "none loaded"
    # A kernel differential owns the whole card while it runs. Say so here, or the
    # GPU figure below reads as an unexplained anomaly.
    sudo docker ps --format 'kernel run: {{.Names}} ({{.Status}})' | grep gpu-lab-kernels | sed 's/^/  /' || true
    # A training run owns most of the card for as long as it lasts. Without this
    # line the GPU figure below is an unexplained 12 GiB on an idle-looking node.
    sudo docker ps --format 'training:   {{.Names}} ({{.Status}})' | grep gpu-lab-training | sed 's/^/  /' || true
    # Same reason as the two lines above: ~20 GiB with nothing named to account
    # for it is the most confusing thing this command can print.
    if [ -n "$pooled" ]; then
        sudo docker ps --format 'pooled:     {{.Names}} ({{.Status}})' | grep -E 'ray-(head|worker)' | sed 's/^/  /' || true
    fi

    say "gpu"
    nvidia-smi --query-gpu=memory.used,memory.total,temperature.gpu,power.draw --format=csv,noheader | sed 's/^/  /'

    say "direct link"
    # Node-agnostic: find whichever end of the /30 this machine owns. A dead
    # link here is the single most common reason the lab looks unreachable from
    # an otherwise healthy server -- see host/laptop-igc-resume-repair.sh.
    dev=$(ip -o route show 10.10.0.0/30 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -1)
    if [ -z "$dev" ]; then
        ok "DOWN -- no 10.10.0.0/30 route (laptop: sudo /usr/local/sbin/gpu-lab-igc-resume-repair)"
    else
        me=$(ip -4 -o addr show "$dev" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
        case "$me" in 10.10.0.1) peer=10.10.0.2 ;; 10.10.0.2) peer=10.10.0.1 ;; *) peer= ;; esac
        ok "$dev $me $(ethtool "$dev" 2>/dev/null | awk -F': ' '/Speed:/{print $2}')"
        if [ -n "$peer" ] && ping -c1 -W2 "$peer" >/dev/null 2>&1; then
            ok "peer $peer OK ($(ping -c3 -W2 -q "$peer" 2>/dev/null | awk -F/ '/rtt/{print $5" ms avg"}'))"
        else
            ok "peer ${peer:-unknown} UNREACHABLE"
        fi
    fi

    say "endpoints"
    endpoints="llama-swap http://localhost:8080/v1/models"
    if [ "$HAS_COMPOSE" = 1 ]; then
        endpoints="$endpoints
prometheus http://localhost:9090/-/healthy
grafana    http://localhost:3000/api/health
litellm    http://localhost:4000/health/liveliness"
    fi
    # Always the desktop's address: ray-head runs the OpenAI server for the whole
    # pool, so the laptop contributes a card without ever serving the endpoint.
    if [ -n "$pooled" ]; then
        endpoints="$endpoints
pooled     http://$DESKTOP_ADDR:$POOL_PORT/v1/models"
    fi
    while IFS= read -r u; do
        [ -z "$u" ] && continue
        name=${u%% *}; addr=${u##* }
        if curl -sf "$addr" >/dev/null 2>&1; then ok "$name OK"; else ok "$name DOWN"; fi
    done <<< "$endpoints"
}

# Config files reach these services as read-only bind mounts, so editing one on
# disk changes nothing in the running container. Prometheus cannot be told to
# re-read either: it runs without --web.enable-lifecycle, so POST /-/reload is
# 403. A restart is the only way to apply an edit, and "docker compose up -d"
# will not do it -- the container spec is unchanged, so compose sees no drift.
# Push is deploy in this repo, so validation has to happen before the push, not
# after it. See bin/check.py.
cmd_check() {
    say "checking configs ($NODE)"
    python3 "$REPO/bin/check.py"
}

# The installed unit lives in /etc/systemd/system, outside the repo, so a deploy
# cannot update it: "git checkout -f main" moves the config file and leaves the
# unit pointing at the old path. Nothing notices until the next restart, which
# may be a reboot weeks later. This is the command that closes that gap, and it
# is why moving files in this repo is a two-step migration rather than a git mv.
cmd_install() {
    local dest=/etc/systemd/system/llama-swap.service
    if [ ! -f "$SWAP_UNIT" ]; then
        echo "missing unit source: $SWAP_UNIT" >&2; exit 1
    fi
    say "installing $NODE unit from $(basename "$SWAP_UNIT")"
    if [ -f "$dest" ] && cmp -s "$SWAP_UNIT" "$dest"; then
        ok "already current -- nothing to do"
    else
        sudo install -m 0644 "$SWAP_UNIT" "$dest"
        sudo systemctl daemon-reload
        ok "installed and daemon-reloaded"
        # Deliberately NOT restarting: that evicts a loaded model. Say so instead.
        if [ "$(sudo systemctl is-active llama-swap 2>/dev/null || true)" = active ]; then
            ok "llama-swap is running on the OLD unit -- 'lab reload' to adopt this one"
        fi
    fi

    # Node-agnostic: the exporter reads whichever card is local, so both nodes
    # install the same unit.
    local gx_src=$REPO/monitoring/gpu-exporter.service
    local gx_dest=/etc/systemd/system/gpu-exporter.service
    if [ -f "$gx_src" ] && ! cmp -s "$gx_src" "$gx_dest"; then
        say "installing gpu-exporter.service"
        sudo install -m 0644 "$gx_src" "$gx_dest"
        sudo systemctl daemon-reload
        sudo systemctl enable gpu-exporter >/dev/null 2>&1 || true
        ok "installed and enabled"
    fi

    # Both checks above ask "is the file the same", which is not the question
    # systemd asks. systemd watches mtime, so a unit rewritten byte-identically,
    # or one installed by an earlier run whose daemon-reload did not land, stays
    # flagged while cmp reports nothing to do -- and the flag survives until
    # something else happens to reload. Ask systemd instead of inferring.
    local stale="" u
    for u in llama-swap gpu-exporter; do
        if [ "$(systemctl show -p NeedDaemonReload --value "$u" 2>/dev/null || true)" = yes ]; then
            stale="$stale $u"
        fi
    done
    if [ -n "$stale" ]; then
        say "systemd still wants a reload for:$stale"
        sudo systemctl daemon-reload
        ok "daemon-reloaded"
    fi
}

cmd_reload() {
    local want="$*" compose_svcs="" restart_swap=0 svc
    if [ -z "$want" ]; then
        if [ "$HAS_COMPOSE" = 1 ]; then
            # llama-swap is deliberately NOT in the default set: restarting it
            # evicts whatever model is loaded and costs a ~90 s reload. Ask for it.
            compose_svcs="prometheus grafana litellm"
        else
            # It is the only config consumer on this node, so there is nothing
            # else a bare reload could mean -- but it still costs an eviction.
            restart_swap=1
        fi
    else
        for svc in $want; do
            case "$svc" in
                llama-swap) restart_swap=1 ;;
                prometheus|grafana|litellm)
                    if [ "$HAS_COMPOSE" = 1 ]; then
                        compose_svcs="$compose_svcs $svc"
                    else
                        echo "$svc runs on the desktop, not here: ssh llm '$REPO/bin/lab reload $svc'" >&2
                        exit 1
                    fi ;;
                *) echo "unknown service: $svc" >&2
                   echo "usage: lab reload [llama-swap|prometheus|grafana|litellm]" >&2
                   exit 1 ;;
            esac
        done
    fi

    if [ "$restart_swap" = 1 ]; then
        say "restarting llama-swap (this evicts any loaded model)"
        sudo systemctl restart llama-swap
        ok "llama-swap: $(sudo systemctl is-active llama-swap || true)"
    fi
    if [ -n "$compose_svcs" ]; then
        say "applying:$compose_svcs"
        # Both are needed, and neither alone is enough:
        #   up -d    recreates a container whose SPEC changed (a moved bind-mount
        #            path, a new env var) -- but does nothing when only the
        #            contents of a mounted file changed.
        #   restart  re-reads a mounted file's CONTENTS -- but keeps the old spec,
        #            so a moved path would be silently ignored.
        # A repo restructure changes the spec; an edited prometheus.yml changes
        # only contents. This command has to cover both.
        # shellcheck disable=SC2086  -- deliberate word splitting into compose
        ( cd "$COMPOSE_DIR" && sudo docker compose up -d $compose_svcs ) 2>&1 | tail -3
        # shellcheck disable=SC2086
        ( cd "$COMPOSE_DIR" && sudo docker compose restart $compose_svcs ) 2>&1 | tail -3
    fi
    say "reloaded ($NODE)."
}

cmd_logs() {
    case "${1:-}" in
        llama-swap) sudo journalctl -u llama-swap -f ;;
        model)      sudo docker logs -f "$(sudo docker ps --format '{{.Names}}' | grep -m1 '^qwen3-')" ;;
        # Not "docker logs ray-head": that shows ray's own startup, not vLLM's.
        # The serve command is exec'd into the head and redirected to a file
        # inside it, which is also the only place the engine's tracebacks land
        # -- and the head is always the desktop, whichever node asks.
        pool)
            if [ "$NODE" = desktop ]; then
                sudo docker exec ray-head tail -f /tmp/vllm-pool.log
            else
                on_desktop 'sudo docker exec ray-head tail -f /tmp/vllm-pool.log'
            fi ;;
        litellm|prometheus|grafana)
            if [ "$HAS_COMPOSE" = 1 ]; then
                ( cd "$COMPOSE_DIR" && sudo docker compose logs -f "$1" )
            else
                echo "$1 runs on the desktop, not here: ssh llm '$REPO/bin/lab logs $1'" >&2; exit 1
            fi ;;
        *) echo "usage: lab logs <llama-swap|model|pool|litellm|prometheus|grafana>" >&2; exit 1 ;;
    esac
}

case "${1:-}" in
    up)     shift; cmd_up "${1:-}" ;;
    down)   shift; cmd_down "$@" ;;
    pool)   shift; cmd_pool "${1:-}" ;;
    status) cmd_status ;;
    logs)   shift; cmd_logs "${1:-}" ;;
    reload) shift; cmd_reload "$*" ;;
    check)  cmd_check ;;
    install) cmd_install ;;
    *) awk '/^#== usage ==/{f=1;next} /^#== end usage ==/{f=0} f' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
